# ==============================================================================
# MAARS Lens Configuration Environment Variables
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=production

# Database Configuration (PostgreSQL in cloud, or SQLite for local demo)
# Local SQLite example: sqlite+aiosqlite:///./maars_lens.db
# PostgreSQL example: postgresql+asyncpg://postgres:password@localhost:5432/maars_lens
DATABASE_URL=sqlite+aiosqlite:///./maars_lens.db

# OCR Engine Configuration
# Supported options: paddleocr (real dual-pass OCR), mock (SIMULATED unit testing)
OCR_ENGINE=paddleocr

# Asynchronous OCR Worker
# Set False for prototype inline synchronous execution (no Redis/Celery required)
# Set True only if Redis + Celery worker service is provisioned
ASYNC_OCR_ENABLED=False
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_JWT_SECRET=super_secret_jwt_signing_key_at_least_32_characters_long

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost"]

# Storage Location for Uploaded Label Evidence & Signed Reports
UPLOAD_DIR=./uploads
REPORTS_DIR=./uploads/reports
