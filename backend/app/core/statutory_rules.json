{
  "rules": [
    {
      "rule_code": "LMPC-R6-NAME-ADDRESS",
      "source_reference": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 6(1)(a)",
      "category": "Mandatory Declarations",
      "rule_type": "presence",
      "target_field": "manufacturer",
      "description": "Name and complete address of the manufacturer or packer or importer must be declared on every package.",
      "severity": "major",
      "active": true,
      "version": 1,
      "legal_verified": true,
      "check_definition": {
        "operator": "exists",
        "confidence_threshold": 0.5
      },
      "exemptions": [
        {
          "type": "institutional_pack"
        }
      ]
    },
    {
      "rule_code": "LMPC-R6-NET-QTY",
      "source_reference": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 6(1)(d)",
      "category": "Net Quantity",
      "rule_type": "presence",
      "target_field": "net_quantity",
      "description": "Net quantity in standard units of weight, measure or number must be declared on package.",
      "severity": "critical",
      "active": true,
      "version": 1,
      "legal_verified": true,
      "check_definition": {
        "operator": "exists",
        "confidence_threshold": 0.5,
        "exempt_if_net_qty_lte_g": 10.0,
        "exempt_if_net_qty_lte_ml": 10.0
      },
      "exemptions": [
        {
          "type": "net_quantity_lte_g",
          "threshold": 10.0
        },
        {
          "type": "net_quantity_lte_ml",
          "threshold": 10.0
        },
        {
          "type": "net_quantity_gte_kg",
          "threshold": 50.0
        }
      ]
    },
