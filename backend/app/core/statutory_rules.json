    {
      "rule_code": "LMPC-R7-FONT-SIZE",
      "source_reference": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 7 Table",
      "category": "Dimensions & Legibility",
      "rule_type": "visual",
      "target_field": "numeral_height_mm",
      "description": "Minimum height of numerals and letters depending on net quantity.",
      "severity": "minor",
      "active": true,
      "version": 1,
      "legal_verified": true,
      "check_definition": {
        "operator": "font_size_band",
        "default_min_height_mm": 2.0,
        "bands": [
          {
            "max_qty": 50,
            "min_height_mm": 1.0
          },
          {
            "min_qty": 50,
            "max_qty": 200,
            "min_height_mm": 2.0
          },
          {
            "min_qty": 200,
            "max_qty": 1000,
            "min_height_mm": 4.0
          },
          {
            "min_qty": 1000,
            "min_height_mm": 6.0
          }
        ]
      },
      "exemptions": [
        {
          "type": "surface_area_lte_cm2",
          "threshold": 10.0
        }
      ]
    },
